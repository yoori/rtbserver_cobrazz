<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            targetNamespace="http://www.adintelligence.net/xsd/AI/Configuration"
            xmlns="http://www.adintelligence.net/xsd/AI/Configuration"
            elementFormDefault="qualified">
  <xsd:include schemaLocation="CommonTypes.xsd"/>

  <xsd:element name="environment">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="forosZoneManagement"
                     type="ZoneManagementType"
                     minOccurs="0"/>
        <xsd:element name="develParams"
                     type="DevelParamsType"
                     minOccurs="0"/>
      </xsd:sequence>
      <xsd:attribute name="autorestart" type="xsd:boolean" default="true"/>
    </xsd:complexType>
  </xsd:element>
</xsd:schema>
