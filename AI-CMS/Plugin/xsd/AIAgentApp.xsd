<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            targetNamespace="http://www.adintelligence.net/xsd/AI/Configuration"
            xmlns="http://www.adintelligence.net/xsd/AI/Configuration"
            elementFormDefault="qualified">
  <xsd:include schemaLocation="CommonTypes.xsd"/>

  <xsd:element name="aiAgent">
    <xsd:complexType>
      <xsd:attribute name="model" type="ShellValue" default="qwen3"/>
      <xsd:attribute name="model_package" type="ShellValue"
                     default="foros-ollama-model-qwen3"/>
      <xsd:attribute name="model_dir" type="ShellValue"
                     default="/u01/foros/server-ai/models/ollama/qwen3"/>
      <xsd:attribute name="ollama_binary" type="ShellValue"
                     default="/opt/foros/ollama/bin/ollama"/>
      <xsd:attribute name="listen_host" type="ShellValue" default="0.0.0.0"/>
      <xsd:attribute name="port" type="xsd:positiveInteger" default="11434"/>
      <xsd:attribute name="agent_listen_host" type="ShellValue" default="0.0.0.0"/>
      <xsd:attribute name="agent_port" type="xsd:positiveInteger" default="11435"/>
      <xsd:attribute name="cluster_agent_listen_host" type="ShellValue"
                     default="127.0.0.1"/>
      <xsd:attribute name="cluster_agent_port" type="xsd:positiveInteger"
                     default="11436"/>
      <xsd:attribute name="mcp_command" type="ShellValue"
                     default="/opt/foros/playwright-mcp/bin/playwright-mcp"/>
      <xsd:attribute name="mcp_allowed_tools" type="ShellValueList"
                     default="browser_click,browser_close,browser_find,browser_hover,browser_navigate,browser_navigate_back,browser_snapshot,browser_tabs,browser_wait_for,web_fetch,web_search"/>
      <xsd:attribute name="browser_allowed_domains" type="ShellValueList"/>
      <xsd:attribute name="browser_proxy_server" type="ShellValue"/>
      <xsd:attribute name="browser_action_timeout_ms" type="xsd:positiveInteger"
                     default="5000"/>
      <xsd:attribute name="browser_navigation_timeout_ms" type="xsd:positiveInteger"
                     default="30000"/>
      <xsd:attribute name="web_mcp_command" type="ShellValue"
                     default="/opt/foros/server-ai/bin/WebToolsMcp.py"/>
      <xsd:attribute name="web_allowed_domains" type="ShellValueList"/>
      <xsd:attribute name="web_proxy_server" type="ShellValue"/>
      <xsd:attribute name="web_request_timeout_ms" type="xsd:positiveInteger"
                     default="30000"/>
      <xsd:attribute name="web_max_download_bytes" type="xsd:positiveInteger"
                     default="2097152"/>
      <xsd:attribute name="web_max_content_chars" type="xsd:positiveInteger"
                     default="100000"/>
      <xsd:attribute name="cluster_mcp_command" type="ShellValue"
                     default="/opt/foros/server-ai/bin/ClusterDataMcp.py"/>
      <xsd:attribute name="cluster_mcp_allowed_tools" type="ShellValueList"
                     default="clickhouse_describe_relation,clickhouse_list_relations,clickhouse_select,postgres_describe_relation,postgres_list_relations,postgres_select"/>
      <xsd:attribute name="postgres_connection_string" type="ShellConnectionString"/>
      <xsd:attribute name="clickhouse_url" type="ShellValue"/>
      <xsd:attribute name="clickhouse_user" type="ShellValue" default="default"/>
      <xsd:attribute name="clickhouse_password" type="ShellValue"/>
      <xsd:attribute name="cluster_query_timeout_ms" type="xsd:positiveInteger"
                     default="5000"/>
      <xsd:attribute name="cluster_max_rows" type="xsd:positiveInteger"
                     default="1000"/>
      <xsd:attribute name="cluster_max_result_bytes" type="xsd:positiveInteger"
                     default="1048576"/>
      <xsd:attribute name="cluster_max_tool_calls" type="xsd:positiveInteger"
                     default="32"/>
      <xsd:attribute name="max_tool_calls" type="xsd:positiveInteger" default="64"/>
      <xsd:attribute name="max_tool_result_bytes" type="xsd:positiveInteger"
                     default="1048576"/>
    </xsd:complexType>
  </xsd:element>
</xsd:schema>
