<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            targetNamespace="http://www.adintelligence.net/xsd/AI/Configuration"
            xmlns="http://www.adintelligence.net/xsd/AI/Configuration"
            elementFormDefault="qualified">
  <xsd:include schemaLocation="CommonTypes.xsd"/>

  <xsd:element name="segmentModelViewer">
    <xsd:complexType>
      <xsd:attribute name="listen_host" type="ShellValue" default="0.0.0.0"/>
      <xsd:attribute name="port" type="xsd:positiveInteger" default="11437"/>
      <xsd:attribute name="url_path" type="xsd:string" default="/"/>
    </xsd:complexType>
  </xsd:element>
</xsd:schema>
