namespace AdServer
{
namespace UserInfoSvcs
{
  /* rocksdb user bind record */
  struct UserBindRocksDBRecordDescriptor
  {
    uint version;
    uint type;
    uint first_seen_time;
    uint update_time;
    string user_id;
    uint flags;
    uint bad_event_count;
    uint last_bad_event_day;
  };

  autoreader UserBindRocksDBRecordReader<UserBindRocksDBRecordDescriptor>;
  autowriter UserBindRocksDBRecordWriter<UserBindRocksDBRecordDescriptor>;

  /* rocksdb user seen record */
  struct UserBindSeenRocksDBRecordDescriptor
  {
    uint version;
    uint first_seen_time;
  };

  autoreader UserBindSeenRocksDBRecordReader<UserBindSeenRocksDBRecordDescriptor>;
  autowriter UserBindSeenRocksDBRecordWriter<UserBindSeenRocksDBRecordDescriptor>;
}
}
