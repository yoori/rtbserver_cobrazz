namespace AdServer
{
namespace RequestInfoSvcs
{
  struct UserNavigationProfileVersionDescriptor
  {
    uint version;
  };

  autoreader UserNavigationProfileVersionReader<UserNavigationProfileVersionDescriptor>;

  struct NavigationDescriptor
  {
    string url;
    uint64 count;
  };

  autoreader NavigationReader<NavigationDescriptor>;

  autowriter NavigationWriter<NavigationDescriptor>;

  struct NavigationDayDescriptor
  {
    uint date;
    array<NavigationDescriptor> navigations;
  };

  reader NavigationDayReader<NavigationDayDescriptor>
  {
    date;
    array<NavigationReader> navigations;
  };

  writer NavigationDayWriter<NavigationDayDescriptor>
  {
    date;
    array<NavigationWriter>(cpp_vector) navigations;
  };

  struct UserNavigationProfileDescriptor
  {
    uint version;
    array<NavigationDayDescriptor> days;
  };

  reader UserNavigationProfileReader<UserNavigationProfileDescriptor>
  {
    version;
    array<NavigationDayReader> days;
  };

  writer UserNavigationProfileWriter<UserNavigationProfileDescriptor>
  {
    version;
    array<NavigationDayWriter>(cpp_vector) days;
  };
}
}
