include_guard(GLOBAL)

if(NOT CMAKE_BUILD_TYPE AND NOT CMAKE_CONFIGURATION_TYPES)
  set(CMAKE_BUILD_TYPE RelWithDebInfo CACHE STRING "Build type" FORCE)
endif()

# set base compile options
set(CPP_DEBUGINFO_FLAGS "-ggdb3")
# -mno-sse2 : required for disable movdqa instruction usage on non aligned uint32 access (Plain library)
set(CPP_COMMON_FLAGS "-Wno-deprecated-declarations -D_REENTRANT -m64 -march=x86-64")
string(APPEND CPP_COMMON_FLAGS " -DPIC -pthread -W -Wall -Werror -mno-sse2")
set(CPP_COMMON_CXX_FLAGS "${CPP_COMMON_FLAGS} -fcoroutines")
set(CPP_DEBUG_OPT_FLAGS "-O0 -g3 -fno-inline -DDEV_DEBUG -rdynamic")
set(CPP_RELEASE_OPT_FLAGS "-O3 -DNDEBUG")
set(CPP_LINKER_FLAGS "-pthread -W -Wall -m64 -march=x86-64")

set(CMAKE_C_FLAGS_DEBUG "${CPP_COMMON_FLAGS} ${CPP_DEBUGINFO_FLAGS} ${CPP_DEBUG_OPT_FLAGS}")
set(CMAKE_C_FLAGS_RELWITHDEBINFO "${CPP_COMMON_FLAGS} ${CPP_DEBUGINFO_FLAGS} ${CPP_RELEASE_OPT_FLAGS}")
set(CMAKE_C_FLAGS_RELEASE "${CPP_COMMON_FLAGS} ${CPP_RELEASE_OPT_FLAGS}")
set(CMAKE_C_FLAGS "${CPP_COMMON_FLAGS}")

set(CMAKE_CXX_FLAGS_DEBUG "${CPP_COMMON_CXX_FLAGS} ${CPP_DEBUGINFO_FLAGS} ${CPP_DEBUG_OPT_FLAGS}")
set(CMAKE_CXX_FLAGS_RELWITHDEBINFO "${CPP_COMMON_CXX_FLAGS} ${CPP_DEBUGINFO_FLAGS} ${CPP_RELEASE_OPT_FLAGS}")
set(CMAKE_CXX_FLAGS_RELEASE "${CPP_COMMON_CXX_FLAGS} ${CPP_RELEASE_OPT_FLAGS}")
set(CMAKE_CXX_FLAGS "${CPP_COMMON_CXX_FLAGS}")

set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
