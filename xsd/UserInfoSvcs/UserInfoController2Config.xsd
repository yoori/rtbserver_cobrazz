<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
  targetNamespace="http://www.adintelligence.net/xsd/AdServer/Configuration"
  xmlns="http://www.adintelligence.net/xsd/AdServer/Configuration"
  elementFormDefault="qualified"
  xml:lang="en"
  version="1.0">

  <xsd:annotation>
    <xsd:documentation>
      UserInfoController2 Configuration File XML Schema
    </xsd:documentation>
  </xsd:annotation>

  <xsd:include schemaLocation="../AdServerCommons/AdServerCommons.xsd"/>

  <xsd:element name="AdConfiguration" type="AdConfigurationType"/>

  <xsd:complexType name="AdConfigurationType">
    <xsd:sequence>
      <xsd:element name="UserInfoController2Config"
        type="UserInfoController2ConfigType"/>
    </xsd:sequence>
  </xsd:complexType>

  <xsd:complexType name="UserInfoController2ConfigType">
    <xsd:sequence>
      <xsd:element name="GrpcConfig" type="GrpcConfigType">
        <xsd:annotation>
          <xsd:documentation>
            GrpcConfig for service
          </xsd:documentation>
        </xsd:annotation>
      </xsd:element>

      <xsd:element name="Logger" type="ErrorLoggerType">
        <xsd:annotation>
          <xsd:documentation>
            Error logger for UserInfoController2
          </xsd:documentation>
        </xsd:annotation>
      </xsd:element>

      <xsd:element name="UserInfoManagerHost"
        type="UserInfoManagerHostType"
        minOccurs="1"
        maxOccurs="unbounded">
        <xsd:annotation>
          <xsd:documentation>
            UserInfoManager gRPC endpoints
          </xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>

    <xsd:attribute name="status_check_period"
      type="xsd:positiveInteger"
      use="required">
      <xsd:annotation>
        <xsd:documentation>period in seconds of checking UserInfoManager hosts.</xsd:documentation>
      </xsd:annotation>
    </xsd:attribute>
  </xsd:complexType>

  <xsd:complexType name="UserInfoManagerHostType">
    <xsd:sequence>
      <xsd:element name="UserInfoManagerGrpcRef"
        type="GrpcEndpointConfigType"
        minOccurs="1"
        maxOccurs="1">
        <xsd:annotation>
          <xsd:documentation>
            UserInfoManager gRPC endpoint
          </xsd:documentation>
        </xsd:annotation>
      </xsd:element>
    </xsd:sequence>
  </xsd:complexType>

</xsd:schema>
