<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
  targetNamespace="http://www.adintelligence.net/xsd/AdServer/Configuration"
  xmlns="http://www.adintelligence.net/xsd/AdServer/Configuration"
  elementFormDefault="qualified" version="1.0">
  <xsd:include schemaLocation="../AdServerCommons/AdServerCommons.xsd"/>
  <xsd:element name="AdConfiguration" type="AdConfigurationType"/>
  <xsd:complexType name="AdConfigurationType">
    <xsd:sequence>
      <xsd:element name="UrlInfoStorageConfig" type="UrlInfoStorageConfigType"/>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="UrlInfoStorageConfigType">
    <xsd:sequence>
      <xsd:element name="GrpcConfig" type="GrpcConfigType"/>
      <xsd:element name="HttpConfig" type="GrpcConfigType"/>
      <xsd:element name="Logger" type="ErrorLoggerType"/>
    </xsd:sequence>
    <xsd:attribute name="pid_file" type="xsd:string" use="required"/>
    <xsd:attribute name="storage_path" type="xsd:string" use="required"/>
    <xsd:attribute name="rocksdb_workers" type="xsd:positiveInteger" default="2"/>
    <xsd:attribute name="rocksdb_batch_size" type="xsd:positiveInteger" default="128"/>
  </xsd:complexType>
</xsd:schema>
